<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="MSTest.TestAdapter"/>
        <PackageReference Include="MSTest.TestFramework"/>
        <!-- Referenced by the code the generator emits; the harness hands it to each test compilation. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vecerdi.Extensions.DependencyInjection.SourceGenerator\Vecerdi.Extensions.DependencyInjection.SourceGenerator.csproj"/>
        <ProjectReference Include="..\Vecerdi.Extensions.DependencyInjection.API\Vecerdi.Extensions.DependencyInjection.API.csproj"/>
    </ItemGroup>

</Project>
